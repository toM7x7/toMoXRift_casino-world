{
  "world": {
    "distDir": "./dist",
    "title": "ブロック遊技村｜海賊カジノ＆アニマルじゃらβ",
    "description": "夕暮れの開放型ブロック遊技公園。BJ／麻雀／船長の運命盤／海賊魔獣ダービーに加え、西港D開発地区で無料のアニマルじゃらβを公開。RIFは現在一方向交換のみ。最大8人BET、同期演出、BGM・効果音、World Storageコインに対応",
    "thumbnailPath": "thumbnail.png",
    "buildCommand": "npm run build",
    "ignore": [
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/*.js.map",
      "**/.gitkeep",
      "**/index.html",
      "**/__federation_shared_@react-three/drei-*.js",
      "**/__federation_shared_@react-three/fiber-*.js",
      "**/__federation_shared_@react-three/rapier-*.js",
      "**/__federation_shared_@xrift/world-components-*.js",
      "**/__federation_shared_three-*.js",
      "**/__federation_shared_three/addons/**",
      "**/__federation_shared_react-*.js",
      "**/__federation_shared_react-dom-*.js",
      "**/__federation_shared_react/jsx-runtime-*.js",
      "**/rapier.es-*.js",
      "**/hls-*.js"
    ],
    "physics": {
      "gravity": 9.81,
      "allowInfiniteJump": false
    },
    "camera": {
      "near": 0.1,
      "far": 80
    },
    "permissions": {
      "allowedDomains": [
        "rif-coin.com"
      ],
      "allowedCodeRules": [
        "no-network-without-permission"
      ]
    }
  }
}
